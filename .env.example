# ============================================
# Quorum environment configuration
# Copy this file to .env.local and fill in your values.
# ============================================

# ============================================
# LLM provider — pick exactly one
# ============================================

# Option 1: Google Gemini (FREE tier — recommended for development)
# Get an API key at https://aistudio.google.com/apikey
LLM_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

# Option 2: Azure AI Foundry (Kimi K2.5 and other MaaS deployments)
# Endpoint pattern: https://{AZURE_RESOURCE_NAME}.services.ai.azure.com/models
# LLM_PROVIDER=azure
# AZURE_RESOURCE_NAME=your-resource-name
# AZURE_API_KEY=your-azure-key
# AZURE_API_VERSION=2024-05-01-preview
# AZURE_CHAT_MODEL_KIMI_25=kimi-k2.5
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Option 3: Anthropic Claude (paid, highest quality)
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-opus-4-6

# ============================================
# Server
# ============================================
DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Log format: "plain" (readable, default) or "json" (for log aggregators).
LOG_FORMAT=plain

# ============================================
# Persistence — project store database
# ============================================
# DATABASE_URL is a SQLAlchemy URL. Leave it unset to use a local SQLite
# file (backend/.quorum_projects.db) — convenient for development. For
# production use PostgreSQL. The docker-compose stack sets this for you.
# DATABASE_URL=postgresql+psycopg2://quorum:quorum@localhost:5432/quorum

# Credentials for the docker-compose `postgres` service.
# POSTGRES_USER=quorum
# POSTGRES_PASSWORD=quorum
# POSTGRES_DB=quorum

# ============================================
# Frontend
# ============================================
# Where the frontend should look for the backend API. Required for
# production deployments where they're on different hosts.
# NEXT_PUBLIC_API_BASE_URL=https://api.quorum.example.com

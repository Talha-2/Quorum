# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF so they run correctly on Windows.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary

{
  "name": "quorum-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"['.next','.source'].forEach((dir)=>require('fs').rmSync(dir,{ recursive: true, force: true }))\"",
    "free-port": "node ../scripts/free-port.mjs 3000",
    "dev": "node ../scripts/dev-frontend.mjs",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/mdx": "^2.0.13",
    "axios": "^1.6.5",
    "d3": "^7.9.0",
    "framer-motion": "^10.16.16",
    "fumadocs-core": "^14.7.7",
    "fumadocs-mdx": "^11.2.3",
    "fumadocs-ui": "^14.7.7",
    "lucide-react": "^0.408.0",
    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "typescript": "^5.3.3"
  }
}
